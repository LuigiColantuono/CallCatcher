<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!--
      Privileged permissions. Granted only when the app is installed as a privileged system app by
      the KernelSU/Magisk module, which allowlists EXACTLY these in
      module/privapp-permissions-com.callcatcher.xml. Every privileged permission requested here
      must be in that file, or a device enforcing the allowlist can fail to boot.
        - CAPTURE_AUDIO_OUTPUT: read the VOICE_CALL stream (both sides of a carrier call).
        - START_ACTIVITIES_FROM_BACKGROUND / START_FOREGROUND_SERVICES_FROM_BACKGROUND: start the
          microphone foreground service when WhatsApp signals a call while the app is in background.
    -->
    <uses-permission
        android:name="android.permission.CAPTURE_AUDIO_OUTPUT"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.START_FOREGROUND_SERVICES_FROM_BACKGROUND"
        tools:ignore="ProtectedPermissions" />

    <application>
        <service
            android:name=".service.RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Signalled by the WhatsApp hook. call() checks the caller package itself. -->
        <provider
            android:name=".service.TriggerProvider"
            android:authorities="${applicationId}.trigger"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
    </application>

</manifest>
